{
  "name": "maildock",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop email organizer.",
  "author": "",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc --project tsconfig.main.json",
    "build-renderer": "tsc --project tsconfig.renderer.json && vite build",
    "build": "npm run build:main && npm run build-renderer",
    "start": "npm run build && electron .",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
